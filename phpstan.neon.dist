parameters:
    level: max
    paths:
        - src
        - examples/shop/src
        - examples/fix-gateway/src
    # Symbols that only exist under FrankenPHP or with spiral/roadrunner-http installed.
    scanFiles:
        - stubs/frankenphp.stub
        - stubs/roadrunner.stub
    excludePaths:
        - src/Runtime/dev-router.php
    tmpDir: var/phpstan
